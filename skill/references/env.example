# paperdl 配置（每人填自己的；本文件可被 paperdl config 自动生成）
# —— 必填：中科院通行证 ——
CSTCLOUD_ID=
CSTCLOUD_PASSWORD=
# —— 可选：Elsevier（留空则走浏览器 Shibboleth）——
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=
# —— 可选：Wiley（留空则走浏览器 Shibboleth）——
WILEY_TDM_TOKEN=
# —— 可选：OpenAlex 检索礼貌池邮箱（留空则回退到通行证账号）——
OPENALEX_MAILTO=
# —— 可选：邮件发送 ——
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=
