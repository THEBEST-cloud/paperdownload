# 复制本文件为 .paperdl.env 并填入你的中国科技云通行证账号密码。
# .paperdl.env 已被 git 忽略，不会进版本库、不会上传。
CSTCLOUD_ID=你的中科院邮箱
CSTCLOUD_PASSWORD=你的密码

# Elsevier 官方 API（在 https://dev.elsevier.com 申请免费 key）。机构 IP 下取全文。
ELSEVIER_API_KEY=
# 可选：图书馆提供的机构令牌(若仅 key 取不到全文)
ELSEVIER_INSTTOKEN=

# Wiley TDM 令牌（在 https://onlinelibrary.wiley.com/library-info/resources/text-and-datamining 申请）
WILEY_TDM_TOKEN=
